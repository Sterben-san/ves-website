# Copy this file's contents into Hostinger's environment variable importer.
# Replace every placeholder before importing. Do not commit real production values.

# Hostinger MySQL / Prisma
DATABASE_URL=mysql://HOSTINGER_DB_USER:HOSTINGER_DB_PASSWORD@HOSTINGER_DB_HOST:3306/HOSTINGER_DB_NAME

# Production mode
NODE_ENV=production

# Auth. Generate two different values with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-different-long-random-refresh-secret

# Cloudinary CMS uploads. Required for admin image/video/PDF uploads.
CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret

# Live public URL. Must be https in production.
NEXT_PUBLIC_SITE_URL=https://your-live-domain.com

# Exactly two seeded admin accounts.
ADMIN_ONE_EMAIL=first-admin@example.com
ADMIN_ONE_PASSWORD=replace-with-strong-password
ADMIN_TWO_EMAIL=second-admin@example.com
ADMIN_TWO_PASSWORD=replace-with-different-strong-password
