# Hostinger MySQL / Prisma
DATABASE_URL=mysql://db_user:db_password@127.0.0.1:3306/db_name

# Auth
JWT_ACCESS_SECRET=replace-with-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret

# Cloudinary CMS uploads
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=your-key
CLOUDINARY_API_SECRET=your-secret

# Public app URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seeded admin accounts. Keep exactly two.
ADMIN_ONE_EMAIL=admin@ves.local
ADMIN_ONE_PASSWORD=change-this-password
ADMIN_TWO_EMAIL=ops@ves.local
ADMIN_TWO_PASSWORD=change-this-password-too
